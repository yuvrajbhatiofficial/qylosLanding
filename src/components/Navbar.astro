---
import { ModeToggle } from "@/components/ModeToggle";
import { NoiseBackground } from "@/components/ui/noise-background";
import { PricingPopup } from "@/components/PricingPopup";
---

<nav
  class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-background/50 backdrop-blur-md"
>
  <div
    class="container relative mx-auto px-6 h-16 flex items-center justify-between"
  >
    <div class="flex items-center gap-2">
      <div class="text-xl font-bold text-foreground tracking-tighter">
        Qylos AI
      </div>
    </div>

    <div
      class="hidden md:flex items-center gap-8 text-sm font-sm text-muted-foreground absolute left-1/2 -translate-x-1/2"
    >
      <a href="#features" class="hover:text-foreground transition-colors"
        >Features</a
      >
      <a href="#testimonials" class="hover:text-foreground transition-colors"
        >Testimonials</a
      >
      <PricingPopup client:load />
    </div>

    <div class="flex items-center gap-4">
      <ModeToggle client:load />
      <div class="flex justify-center">
        <NoiseBackground
          client:load
          containerClassName="w-fit p-2 rounded-full mx-auto"
          gradientColors={[
            "rgb(255, 100, 150)",
            "rgb(100, 150, 255)",
            "rgb(255, 200, 100)",
          ]}
        >
          <a
            href="#early-access"
            class="inline-flex items-center justify-center h-full w-full cursor-pointer rounded-full bg-gradient-to-r from-neutral-100 via-neutral-100 to-white px-4 py-2 text-black shadow-[0px_2px_0px_0px_var(--color-neutral-50)_inset,0px_0.5px_1px_0px_var(--color-neutral-400)] transition-all duration-100 active:scale-98 dark:from-black dark:via-black dark:to-neutral-900 dark:text-white dark:shadow-[0px_1px_0px_0px_var(--color-neutral-950)_inset,0px_1px_0px_0px_var(--color-neutral-800)]"
          >
            Get Started &rarr;
          </a>
        </NoiseBackground>
      </div>
    </div>
  </div>
</nav>
